# Example environment configuration for StAnify
# Copy to .env and customize for your setup

# Image Generation Backend
# Options: "placeholder", "sdxl-a1111", "sdxl-comfyui"
IMAGE_BACKEND=placeholder

# Automatic1111 Settings (if using sdxl-a1111)
A1111_BASE_URL=http://127.0.0.1:7860
A1111_MODEL=sdxl_base_1.0

# ComfyUI Settings (if using sdxl-comfyui)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/sdxl_workflow.json

# SDXL Default Parameters
SDXL_WIDTH=1024
SDXL_HEIGHT=768
SDXL_CFG_SCALE=6.5
SDXL_STEPS=30
SDXL_SAMPLER=DPM++ 2M Karras

# LLM Settings
LLM_MODEL=gpt-4
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# File Paths
OUTPUT_DIR=./exports
ASSETS_DIR=./assets

# Network & Performance
HTTP_TIMEOUT=60.0
MAX_RETRIES=3

# Debug & Logging
DEBUG=false
LOG_LEVEL=INFO
