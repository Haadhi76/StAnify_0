# StAnify Environment Configuration
# Copy this to .env or set as system environment variables

# =============================================================================
# IMAGE GENERATION BACKEND CONFIGURATION
# =============================================================================

# Backend selection: auto, stability, sdxl-a1111, placeholder
# - auto: Automatically choose best available (stability > a1111 > placeholder)
# - stability: Use Stability AI cloud API (requires API key)
# - sdxl-a1111: Use local Automatic1111 installation
# - placeholder: Use enhanced placeholder images
IMAGE_BACKEND=stability

# =============================================================================
# STABILITY AI CONFIGURATION (for stability backend)
# =============================================================================

# Required: Your Stability AI API key
# Get from: https://platform.stability.ai/account/keys
STABILITY_API_KEY=sk-your-stability-api-key-here

# Optional: Stability AI API base URL (default shown)
STABILITY_BASE_URL=https://api.stability.ai

# Optional: Model selection
# Available models depend on your plan:
# - stable-image-ultra (latest, high quality)
# - stable-image-core (fast, efficient)
# - sd3-large, sd3-medium (Stable Diffusion 3.x)
# - stable-diffusion-xl-1024-v1-0 (SDXL)
STABILITY_MODEL=stable-image-ultra

# Optional: Generation parameters
STABILITY_GUIDANCE=7.0
STABILITY_STEPS=30

# =============================================================================
# AUTOMATIC1111 CONFIGURATION (for sdxl-a1111 backend)
# =============================================================================

# A1111 API URL (when running locally with --api flag)
A1111_BASE_URL=http://127.0.0.1:7860

# Model checkpoint to use in A1111
A1111_MODEL=sdxl_base_1.0

# =============================================================================
# DEFAULT SDXL PARAMETERS (applied to all backends)
# =============================================================================

# Image dimensions
SDXL_WIDTH=1024
SDXL_HEIGHT=768

# Generation quality settings
SDXL_CFG_SCALE=6.5
SDXL_STEPS=30
SDXL_SAMPLER=DPM++ 2M Karras

# =============================================================================
# LLM CONFIGURATION (for content generation)
# =============================================================================

# LLM model selection
# - gpt-4, gpt-4-turbo (requires OPENAI_API_KEY)
# - claude-3-sonnet, claude-3-haiku (requires ANTHROPIC_API_KEY)
# - local-stub (for testing without LLM)
LLM_MODEL=local-stub

# API keys for LLM services
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Output directories
OUTPUT_DIR=./exports
ASSETS_DIR=./assets

# HTTP settings
HTTP_TIMEOUT=120.0
MAX_RETRIES=3

# Debug settings
DEBUG=false
LOG_LEVEL=INFO
